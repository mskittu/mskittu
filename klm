import os, json, requests, sys
from requests.auth import HTTPBasicAuth

TWS_HOST = "https://twsus-prod.barcapint.com:9443"
TWS_USER     = os.environ.get("TWS_USER")
TWS_PASSWORD = os.environ.get("TWS_PASSWORD")

TEST_STREAM  = "RFTBDHING01DAY1"
TEST_JOB     = "RFT-BDH-INGEST-CR-BURAU-PRMR-ATRB-TRU-HS"

SEP = "=" * 60

def check_credentials():
    if not TWS_USER or not TWS_PASSWORD:
        print("FAIL  Credentials missing.")
        print("      Set TWS_USER and TWS_PASSWORD env variables.")
        print("      Linux:   export TWS_USER='your_username'")
        print("               export TWS_PASSWORD='your_password'")
        sys.exit(1)
    print(f"OK    Credentials loaded  (user: {TWS_USER})")

def test_connectivity():
    print(SEP)
    print("TEST 1 — Network connectivity")
    print(SEP)
    url = f"{TWS_HOST}/twsd/api/v1/jobs"
    try:
        r = requests.get(
            url,
            auth=HTTPBasicAuth(TWS_USER, TWS_PASSWORD),
            verify=False,
            timeout=10
        )
        print(f"OK    Reached TWS server  (HTTP {r.status_code})")
        return r.status_code
    except requests.exceptions.ConnectionError:
        print(f"FAIL  Cannot reach {TWS_HOST}")
        print("      Check: VPN connected? Firewall allows port 9443?")
        sys.exit(1)
    except requests.exceptions.Timeout:
        print("FAIL  Connection timed out after 10 seconds.")
        sys.exit(1)

def test_auth(status_code):
    print()
    print(SEP)
    print("TEST 2 — Credential authentication")
    print(SEP)
    if status_code == 200:
        print(f"OK    Credentials accepted  (HTTP 200)")
    elif status_code == 401:
        print("FAIL  HTTP 401 Unauthorized — wrong username or password.")
        print(f"      User tried: {TWS_USER}")
        sys.exit(1)
    elif status_code == 403:
        print("FAIL  HTTP 403 Forbidden — user exists but lacks permission.")
        sys.exit(1)
    else:
        print(f"WARN  Unexpected HTTP {status_code} — check TWS API config.")

def test_job_fetch():
    print()
    print(SEP)
    print("TEST 3 — Fetch one job status from TWS API")
    print(SEP)
    url    = f"{TWS_HOST}/twsd/api/v1/jobs"
    params = {"jobStream": TEST_STREAM, "job": TEST_JOB}
    try:
        r = requests.get(
            url,
            params=params,
            auth=HTTPBasicAuth(TWS_USER, TWS_PASSWORD),
            verify=False,
            timeout=30
        )
        print(f"URL:  {r.url}")
        print(f"HTTP: {r.status_code}")
        if r.status_code != 200:
            print(f"FAIL  API returned HTTP {r.status_code}")
            print(f"      Response: {r.text[:300]}")
            return None
        data = r.json()
        print()
        print("Raw API response (first 800 chars):")
        print(json.dumps(data, indent=2)[:800])
        return data
    except Exception as e:
        print(f"FAIL  Exception: {e}")
        return None

def test_status_parse(data):
    print()
    print(SEP)
    print("TEST 4 — Parse status field from response")
    print(SEP)
    if data is None:
        print("SKIP  No data to parse (Test 3 failed).")
        return
    status = None
    if isinstance(data, dict) and "jobs" in data and data["jobs"]:
        status = data["jobs"][0].get("status")
        print(f"OK    Found via data['jobs'][0]['status'] = '{status}'")
    elif isinstance(data, list) and data:
        status = data[0].get("status")
        print(f"OK    Found via data[0]['status'] = '{status}'")
    elif isinstance(data, dict) and "status" in data:
        status = data.get("status")
        print(f"OK    Found via data['status'] = '{status}'")
    else:
        print("WARN  Could not find 'status' in the response.")
        print("      Response keys:", list(data.keys()) if isinstance(data,dict) else type(data))
        print("      Adjust the parser in update_tws_status_secure.py.")
        return
    print(f"      Normalized status will be: {normalize(status)}")

def normalize(s):
    if not s: return "UNKNOWN"
    s = str(s).upper()
    if s in ["SUCC","SUCCESS","COMPLETED"]: return "SUCCESS"
    if s in ["ABEND","FAILED","FAIL","ERROR"]: return "FAILED"
    if s in ["EXEC","RUNNING"]: return "RUNNING"
    if s in ["READY"]: return "READY"
    if s in ["WAIT","WAITING"]: return "WAITING"
    if s in ["HOLD"]: return "HOLD"
    return "UNKNOWN"

if __name__ == "__main__":
    print()
    print(SEP)
    print("TWS CONNECTION TEST")
    print(f"Host: {TWS_HOST}")
    print(SEP)
    check_credentials()
    code = test_connectivity()
    test_auth(code)
    data = test_job_fetch()
    test_status_parse(data)
    print()
    print(SEP)
    print("All tests complete.")
    print(SEP)
    print()
